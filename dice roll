class Solution {
    public int numRollsToTarget(int n, int k, int target) {
        int MOD = 1000000007;
        int[] dp = new int[target + 1];
        dp[0] = 1;
        
        for (int i = 1; i <= n; i++) {
            int[] nextDp = new int[target + 1];
            
            for (int j = 1; j <= target; j++) {
                for (int f = 1; f <= k; f++) {
                    if (j >= f) {
                        nextDp[j] = (nextDp[j] + dp[j - f]) % MOD;
                    } else {
                        break;
                    }
                }
            }
            dp = nextDp;
        }
        
        return dp[target];
    }
}
