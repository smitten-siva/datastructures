class Solution {
    public int maxStudents(char[][] seats) {
        int m = seats.length;
        int n = seats[0].length;
        
        int[] validity = new int[m];
        for (int i = 0; i < m; i++) {
            int cur = 0;
            for (int j = 0; j < n; j++) {
                if (seats[i][j] == '.') {
                    cur |= (1 << j);
                }
            }
            validity[i] = cur;
        }
        
        int[][] dp = new int[m + 1][1 << n];
        for (int i = 0; i <= m; i++) {
            java.util.Arrays.fill(dp[i], -1);
        }
        dp[0][0] = 0;
        
        for (int i = 1; i <= m; i++) {
            int validMasks = validity[i - 1];
            for (int currMask = 0; currMask < (1 << n); currMask++) {
                if ((currMask & validMasks) == currMask && (currMask & (currMask >> 1)) == 0) {
                    for (int prevMask = 0; prevMask < (1 << n); prevMask++) {
                        if (dp[i - 1][prevMask] != -1) {
                            if ((currMask & (prevMask >> 1)) == 0 && ((currMask >> 1) & prevMask) == 0) {
                                dp[i][currMask] = Math.max(dp[i][currMask], dp[i - 1][prevMask] + Integer.bitCount(currMask));
                            }
                        }
                    }
                }
            }
        }
        
        int ans = 0;
        for (int mask = 0; mask < (1 << n); mask++) {
            ans = Math.max(ans, dp[m][mask]);
        }
        return ans;
    }
}
